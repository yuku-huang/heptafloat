{
  "name": "heptafloat",
  "version": "0.9.12-win.5",
  "private": true,
  "description": "Today's Heptabase journal in a floating, editable card for macOS and Windows.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:windows": "node scripts/build-windows.mjs",
    "start:windows": "npm run build:windows && node scripts/run-windows.cjs",
    "test": "node --test test/windows.test.mjs test/editor-commands.test.mjs test/code-block.test.mjs test/hepta-links.test.mjs",
    "test:windows": "npm run build:windows && node scripts/run-windows.cjs --smoke-test",
    "test:windows:live": "npm run build:windows && node scripts/run-windows.cjs --live-smoke",
    "test:preview": "npm run build:windows && node scripts/run-windows.cjs --preview-smoke",
    "package:windows": "npm run build:windows && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2"
  }
}
